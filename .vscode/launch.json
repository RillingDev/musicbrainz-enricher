{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"inputs": [
		{
			"id": "musicbrainzUsername",
			"description": "Musicbrainz username",
			"type": "promptString",
		},
		{
			"id": "musicbrainzPassword",
			"description": "Musicbrainz password",
			"type": "promptString",
			"password": true
		}
	],
	"configurations": [
		{
			"type": "lldb",
			"request": "launch",
			"name": "Debug executable 'musicbrainz_enricher' with mode 'gather'",
			"cargo": {
				"args": [
					"build",
					"--bin=musicbrainz_enricher",
					"--package=musicbrainz_enricher"
				],
				"filter": {
					"name": "musicbrainz_enricher",
					"kind": "bin"
				}
			},
			"args": ["gather"],
			"cwd": "${workspaceFolder}"
		},
		{
			"type": "lldb",
			"request": "launch",
			"name": "Debug executable 'musicbrainz_enricher' with mode 'submit'",
			"cargo": {
				"args": [
					"build",
					"--bin=musicbrainz_enricher",
					"--package=musicbrainz_enricher"
				],
				"filter": {
					"name": "musicbrainz_enricher",
					"kind": "bin"
				}
			},
			"args": [
				"submit",
				"--musicbrainz-url=https://test.musicbrainz.org",
				"--musicbrainz-username=${input:musicbrainzUsername}",
				"--musicbrainz-password=${input:musicbrainzPassword}"
			],
			"cwd": "${workspaceFolder}"
		},
		{
			"type": "lldb",
			"request": "launch",
			"name": "Debug unit tests in executable 'musicbrainz_enricher'",
			"cargo": {
				"args": [
					"test",
					"--no-run",
					"--bin=musicbrainz_enricher",
					"--package=musicbrainz_enricher"
				],
				"filter": {
					"name": "musicbrainz_enricher",
					"kind": "bin"
				}
			},
			"args": [],
			"cwd": "${workspaceFolder}"
		}
	]
}
